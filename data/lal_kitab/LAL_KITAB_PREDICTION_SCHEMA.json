{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LalKitabPredictionContentSchema",
  "description": "Standardized schema for 15-category Lal Kitab classical predictive aphorisms with strict classical traceability and mandatory fallback verification.",
  "type": "object",
  "required": [
    "schemaVersion",
    "categories",
    "fallbackTemplate",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0-audited"]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nameHi", "nameEn", "description"],
        "properties": {
          "id": { "type": "string" },
          "nameHi": { "type": "string" },
          "nameEn": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "fallbackTemplate": {
      "type": "object",
      "required": ["predictionHi", "predictionEn", "sourceRuleId", "isVerified"],
      "properties": {
        "predictionHi": { "type": "string", "const": "भविष्यवाणी उपलब्ध नहीं: शास्त्रीय स्रोत सत्यापन लंबित" },
        "predictionEn": { "type": "string", "const": "Prediction not available: classical source verification pending" },
        "sourceRuleId": { "type": "string", "const": "UNVERIFIED_PENDING_AUDIT" },
        "isVerified": { "type": "boolean", "const": false }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PredictionRecord"
      }
    }
  },
  "$defs": {
    "PredictionRecord": {
      "type": "object",
      "required": [
        "id",
        "category",
        "titleHi",
        "titleEn",
        "predictionHi",
        "predictionEn",
        "sourceRuleId",
        "farmanNumber",
        "safaNumber",
        "hindiExcerpt",
        "isVerified"
      ],
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "generalNature",
            "healthLongevity",
            "financialWealth",
            "careerProfession",
            "familyAncestry",
            "maritalLife",
            "childrenProgeny",
            "houseSpecificPlacements",
            "syntheticMasnooi",
            "dormancyEffects",
            "tevaThemes",
            "planetaryCollisions",
            "deceitRays",
            "annualVarshphal",
            "rahuKetuAxis"
          ]
        },
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "predictionHi": { "type": "string" },
        "predictionEn": { "type": "string" },
        "sourceRuleId": { "type": "string" },
        "farmanNumber": { "type": "integer", "minimum": 1, "maximum": 14 },
        "safaNumber": { "type": "integer", "minimum": 1, "maximum": 234 },
        "hindiExcerpt": { "type": "string" },
        "isVerified": { "type": "boolean" }
      }
    }
  }
}
